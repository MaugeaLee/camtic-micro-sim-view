# 복사:  copy .env.example .env
# .env 는 git에 올리지 않는다. 이미 있는 환경변수가 파일보다 우선한다.

HOST=127.0.0.1
PORT=8790
APP_NAME=micro-cell-viewer

# GLB 디스크 경로(레포 루트 기준 또는 절대경로)와 URL
ASSET_DIR=src/render_asset
ASSET_URL=/assets

# API. 프론트는 이 값을 index.html 주입(__ENV)으로 받는다.
API_PREFIX=/api
API_STATUS=/api/status
API_ASSETS=/api/assets
API_CONFIG=/api/config
API_ASSET_VIEWER=/api/asset-viewer
API_DOCS=/api/docs
API_OPENAPI=/api/openapi.json
