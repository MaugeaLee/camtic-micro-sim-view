# 복사:  copy .env.example .env
# .env 는 git에 올리지 않는다. 이미 있는 환경변수가 파일보다 우선한다.

HOST=127.0.0.1
PORT=8790
APP_NAME=micro-cell-viewer

# GLB 디스크 경로(레포 루트 기준 또는 절대경로)와 URL
ASSET_DIR=src/render_asset
ASSET_URL=/assets

# 쓰는 자리 JSON. 없거나 깨지면 src/layout.default.json 만 읽는다. PUT은 여기만 쓴다.
LAYOUT_FILE=data/layout.json

# 장 B 구독(/dashboard). micro-assembly를 같은 PC에서 띄웠다는 가정의 기본값. 구독·GET만 한다.
# B_MQTT_URL=mqtt://127.0.0.1:1883
# B_MQTT_TOPICS=opcua/json/#,aas/+/environment
# B_FAC_URL=http://127.0.0.1:8765/api/fac
# 조인 브리지(npm run bridge, V3-3). DTO·토픽 형식은 가정 — docx/09-limits-and-join.md
# JOIN_MQTT_TOPICS=opcua/json/#
# JOIN_ZMQ_BIND=tcp://127.0.0.1:5558
# JOIN_TAG_MAP=data/tag_map.json
# JOIN_HEALTH_MS=5000
