# 복사:  copy .env.example .env
# .env 는 git에 올리지 않는다. 이미 있는 환경변수가 파일보다 우선한다.

HOST=127.0.0.1
PORT=8790
APP_NAME=micro-cell-viewer

# GLB 디스크 경로(레포 루트 기준 또는 절대경로)와 URL
ASSET_DIR=src/render_asset
ASSET_URL=/assets

# 쓰는 자리 JSON. 없거나 깨지면 src/layout.default.json 만 읽는다. PUT은 여기만 쓴다.
LAYOUT_FILE=data/layout.json
